{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/provider-fallback-journal.v1.json",
  "title": "ProviderFallbackJournal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "attempts", "finalOutcome"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "policy": { "enum": ["COMPATIBLE_ONLY", "HUMAN_REQUIRED", "DISABLED"] },
    "initialProvider": { "type": "string", "minLength": 1 },
    "selectedProvider": { "type": "string", "minLength": 1 },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "modelId", "phase", "outcome", "reasonCode", "disclosureCompatible", "mutationSafe"],
        "properties": {
          "providerId": { "type": "string", "minLength": 1 },
          "modelId": { "type": "string", "minLength": 1 },
          "phase": { "enum": ["ELIGIBILITY", "BINARY_VERIFICATION", "DISPATCH"] },
          "outcome": { "enum": ["REJECTED", "FAILED", "SELECTED", "SUCCEEDED"] },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "disclosureCompatible": { "type": "boolean" },
          "mutationSafe": { "type": "boolean" }
        }
      }
    },
    "finalOutcome": { "enum": ["SUCCEEDED", "FAILED", "BLOCKED", "EXHAUSTED", "UNKNOWN"] }
  }
}
