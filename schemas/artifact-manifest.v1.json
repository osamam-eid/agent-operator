{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/artifact-manifest.v1.json",
  "title": "ArtifactManifest.v1",
  "description": "ArtifactManifest.v1 (plan §11): typed record of a produced artifact.",
  "type": "object",
  "properties": {
    "artifactId": {
      "type": "string",
      "description": "Artifact identifier.",
      "minLength": 1,
      "maxLength": 256
    },
    "artifactType": {
      "type": "string",
      "description": "Artifact contract type, e.g. implementation-plan.v1, patch.v1, test-evidence.v1 (plan §11).",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
    },
    "producedByNodeId": {
      "$ref": "#/$defs/NodeIdRef"
    },
    "operatorSessionId": {
      "type": "string",
      "description": "Owning OperatorSession.operatorSessionId.",
      "minLength": 1,
      "maxLength": 256
    },
    "hash": {
      "type": "string",
      "description": "Content hash of the artifact.",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[0-9a-f]{64}$"
    },
    "location": {
      "type": "string",
      "description": "Opaque, resolvable storage reference/URI for the artifact content.",
      "minLength": 1,
      "maxLength": 2048
    },
    "sizeBytes": {
      "type": "integer",
      "description": "Artifact content size in bytes.",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the artifact was produced."
    },
    "contentSummary": {
      "type": "string",
      "description": "Concise, decision-oriented summary of the artifact content; never a raw reasoning trace.",
      "minLength": 1,
      "maxLength": 2000
    },
    "policyRefs": {
      "type": "array",
      "description": "Versioned policy citations governing this artifact.",
      "items": {
        "$ref": "#/$defs/PolicyRef"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "artifactId",
    "artifactType",
    "producedByNodeId",
    "operatorSessionId",
    "hash",
    "location",
    "createdAt",
    "contentSummary",
    "policyRefs"
  ],
  "additionalProperties": false,
  "$defs": {
    "NodeIdRef": {
      "type": "string",
      "description": "Graph/template nodeId reference.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "PolicyRef": {
      "type": "string",
      "description": "Versioned policy citation, e.g. masar@3:review.maxRounds or secure-code@2:independentVerification (plan §5, §6).",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+:[a-zA-Z0-9_.]+$"
    }
  }
}
