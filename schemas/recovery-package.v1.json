{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/recovery-package.v1.json",
  "title": "RecoveryPackage.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recoveryId", "worktreeId", "worktreeIdentity", "baselineIdentity", "baselineDigest", "scopeHash", "contractHash", "graphHash", "allowedPaths", "changedPaths", "mutationClass", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "recoveryId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "worktreeId": { "type": "string", "minLength": 1 },
    "worktreeIdentity": { "type": "string", "minLength": 1 },
    "baselineIdentity": { "type": "string", "minLength": 1 },
    "baselineDigest": { "type": "string", "minLength": 1 },
    "scopeHash": { "type": "string", "minLength": 1 },
    "contractHash": { "type": "string", "minLength": 1 },
    "graphHash": { "type": "string", "minLength": 1 },
    "allowedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "changedPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "mutationClass": { "enum": ["LOCAL", "EXTERNAL", "DESTRUCTIVE"] },
    "status": { "enum": ["PREPARED", "MUTATED", "VERIFIED", "CLEANED", "REQUIRES_HUMAN"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
