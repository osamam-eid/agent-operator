{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/operator-command-outcome.v1.json",
  "title": "OperatorCommandOutcome.v1",
  "description": "Result of one `/operator` command invocation. errorCode is present exactly when ok is false and absent when ok is true. When present together, operatorSessionId, session.operatorSessionId, and gate.operatorSessionId must all agree (validators.ts enforces these cross-field invariants; this schema documents the object shape).",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "Whether the command completed successfully."
    },
    "text": {
      "type": "string",
      "description": "Human-facing command output.",
      "minLength": 1,
      "maxLength": 20000
    },
    "errorCode": {
      "$ref": "#/$defs/OperatorCommandErrorCode"
    },
    "operatorSessionId": {
      "type": "string",
      "description": "The session this outcome pertains to, when applicable.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "session": {
      "$ref": "https://omp.local/agent-operator/schemas/operator-session.v1.json"
    },
    "gate": {
      "$ref": "https://omp.local/agent-operator/schemas/human-gate.v1.json"
    }
  },
  "required": [
    "ok",
    "text"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "not": {
          "required": [
            "errorCode"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "errorCode"
        ]
      }
    }
  ],
  "$defs": {
    "OperatorCommandErrorCode": {
      "type": "string",
      "description": "Known /operator command error codes.",
      "enum": [
        "INVALID_COMMAND",
        "NO_ACTIVE_SESSION",
        "SESSION_NOT_FOUND",
        "SESSION_ALREADY_ACTIVE",
        "INVALID_TRANSITION",
        "GATE_NOT_FOUND",
        "GATE_NOT_OPEN",
        "GATE_MISMATCH",
        "CONTRACT_INVALID",
        "STORE_CONFLICT",
        "NODE_EXECUTION_FAILED",
        "COMPILATION_FAILED",
        "ADAPTER_UNAVAILABLE",
        "EXECUTION_ACTIVE",
        "EXECUTION_TIMEOUT",
        "INVALID_OUTPUT",
        "BLOCKED_REQUIRED_CONTEXT",
        "BLOCKED_PROVIDER_UNAVAILABLE",
        "BLOCKED_CAPABILITY",
        "BLOCKED_SECURITY",
        "FEATURE_SET_MISMATCH",
        "STAGE7_ROUTE_UNAVAILABLE",
        "STAGE7_CAPABILITY_UNAVAILABLE"
      ]
    }
  }
}
