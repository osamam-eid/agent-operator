{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/semantic-classification-result.v1.json",
  "title": "SemanticClassificationResult.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "disposition", "proposal", "rawConfidence", "alternatives", "evidence", "modelProvider", "modelId"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "disposition": { "enum": ["EXECUTE", "DO_NOT_EXECUTE", "NEEDS_CLARIFICATION"] },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestClassification", "riskClassification", "confidence", "decomposable", "semanticCapabilities", "rationale"],
      "properties": {
        "requestClassification": { "enum": ["RESEARCH", "PLAN", "IMPLEMENT", "REVIEW", "UI", "QA", "SECURITY", "OPERATIONS"] },
        "riskClassification": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "abstentionReason": { "type": "string", "minLength": 1 },
        "decomposable": { "type": "boolean" },
        "semanticCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requestedExecutionShape": { "enum": ["SINGLE", "PARALLEL", "PIPELINE", "COUNCIL"] },
        "requestedBudgetProfile": { "enum": ["CHEAP", "BALANCED", "QUALITY", "CRITICAL"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "rawConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "confidence"],
        "properties": {
          "family": { "enum": ["RESEARCH", "PLAN", "IMPLEMENT", "REVIEW", "UI", "QA", "SECURITY", "OPERATIONS"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "modelProvider": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "cost"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
