{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/route-decision.v1.json",
  "title": "RouteDecision.v1",
  "description": "RouteDecision.v1 (plan §6): deterministic routing/compilation output for one request.",
  "type": "object",
  "properties": {
    "requestClassification": {
      "$ref": "#/$defs/TaskFamily"
    },
    "riskClassification": {
      "$ref": "#/$defs/RiskLevel"
    },
    "selectedWorkflow": {
      "type": "string",
      "description": "Selected WorkflowTemplate.templateId, e.g. plan.v1.",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]+$"
    },
    "selectedRolesProviders": {
      "type": "array",
      "description": "Roles/providers selected to fill each required template capability.",
      "items": {
        "$ref": "#/$defs/RoleAssignment"
      },
      "minItems": 1
    },
    "rejectedAlternatives": {
      "type": "array",
      "description": "Alternatives considered and rejected.",
      "items": {
        "$ref": "#/$defs/RejectedAlternative"
      },
      "minItems": 0
    },
    "requiredGates": {
      "type": "array",
      "description": "Gate categories this route requires.",
      "items": {
        "$ref": "#/$defs/GateDecisionType"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "budgetEffect": {
      "$ref": "#/$defs/BudgetEffect"
    },
    "fallbackDecisions": {
      "type": "array",
      "description": "Role-compatible fallback decisions applied while routing.",
      "items": {
        "$ref": "#/$defs/FallbackDecision"
      },
      "minItems": 0
    },
    "reasonCodes": {
      "type": "array",
      "description": "Typed reason codes justifying this route.",
      "items": {
        "$ref": "#/$defs/ReasonCodeToken"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "policyRefs": {
      "type": "array",
      "description": "Versioned policy citations for this route (plan §6: every policy-derived route cites policyRefs).",
      "items": {
        "$ref": "#/$defs/PolicyRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "abstention": {
      "$ref": "#/$defs/Abstention"
    }
  },
  "required": [
    "requestClassification",
    "riskClassification",
    "selectedWorkflow",
    "selectedRolesProviders",
    "rejectedAlternatives",
    "requiredGates",
    "budgetEffect",
    "fallbackDecisions",
    "reasonCodes",
    "policyRefs",
    "confidence",
    "abstention"
  ],
  "additionalProperties": false,
  "$defs": {
    "Abstention": {
      "type": "object",
      "description": "Whether the operator abstained from a confident automatic route (plan §6).",
      "properties": {
        "abstained": {
          "type": "boolean",
          "description": "Whether the operator abstained."
        },
        "reason": {
          "type": "string",
          "description": "Why the operator abstained. Required and non-empty when abstained is true.",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "abstained"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "abstained": {
                "const": true
              }
            },
            "required": [
              "abstained"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "BudgetEffect": {
      "type": "object",
      "description": "Effect of a route on the active budget profile.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/BudgetProfile"
        },
        "estimatedTokens": {
          "type": "integer",
          "description": "Estimated token usage.",
          "minimum": 0
        },
        "estimatedCost": {
          "type": "number",
          "description": "Estimated monetary/unit cost.",
          "minimum": 0
        },
        "estimatedDurationMs": {
          "type": "integer",
          "description": "Estimated wall-clock duration in milliseconds.",
          "minimum": 0
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "BudgetProfile": {
      "type": "string",
      "description": "Budget profile selectable via --budget (plan §10).",
      "enum": [
        "CHEAP",
        "BALANCED",
        "QUALITY",
        "CRITICAL"
      ]
    },
    "Confidence": {
      "type": "string",
      "description": "Confidence/abstention tier (plan §6). LOW never automatically selects a more expensive model or council.",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "FallbackDecision": {
      "type": "object",
      "description": "One role-compatible fallback decision applied while routing (plan §10).",
      "properties": {
        "role": {
          "type": "string",
          "description": "Role the fallback applies to.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "from": {
          "type": "string",
          "description": "Originally preferred capability/provider id.",
          "minLength": 1,
          "maxLength": 256
        },
        "to": {
          "type": "string",
          "description": "Actually selected capability/provider id.",
          "minLength": 1,
          "maxLength": 256
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCodeToken"
        }
      },
      "required": [
        "role",
        "from",
        "to",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "GateDecisionType": {
      "type": "string",
      "description": "HumanGate decision category (plan §9, §18).",
      "enum": [
        "PLAN_APPROVAL",
        "EXECUTION_APPROVAL",
        "RESULT_APPROVAL",
        "PUBLICATION_APPROVAL",
        "APPROVE_PROGRESSION",
        "CUSTOM_DECISION"
      ]
    },
    "PolicyRef": {
      "type": "string",
      "description": "Versioned policy citation, e.g. masar@3:review.maxRounds or secure-code@2:independentVerification (plan §5, §6).",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+:[a-zA-Z0-9_.]+$"
    },
    "ReasonCodeToken": {
      "type": "string",
      "description": "SCREAMING_SNAKE_CASE typed reason token.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "RejectedAlternative": {
      "type": "object",
      "description": "One rejected routing alternative, with reason code (plan §2 /operator why).",
      "properties": {
        "option": {
          "type": "string",
          "description": "Rejected role/provider/approach name.",
          "minLength": 1,
          "maxLength": 128
        },
        "reasonCode": {
          "$ref": "#/$defs/ReasonCodeToken"
        },
        "details": {
          "type": "string",
          "description": "Additional human-readable rejection detail.",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "option",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "RiskLevel": {
      "type": "string",
      "description": "Risk classification carried by a RouteDecision.",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "RoleAssignment": {
      "type": "object",
      "description": "One role-to-provider selection within a RouteDecision.",
      "properties": {
        "role": {
          "type": "string",
          "description": "Template role name, e.g. planner, independent-reviewer.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "capabilityId": {
          "type": "string",
          "description": "Selected CapabilityRecord.id.",
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": "string",
          "description": "Concrete provider/role name selected, e.g. opus, codex-high.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": [
        "role",
        "capabilityId",
        "provider"
      ],
      "additionalProperties": false
    },
    "TaskFamily": {
      "type": "string",
      "description": "V1 task family classification (plan §6).",
      "enum": [
        "DIRECT",
        "RESEARCH",
        "PLAN",
        "IMPLEMENT",
        "REVIEW",
        "UI",
        "QA",
        "SECURITY",
        "OPERATIONS"
      ]
    }
  }
}
