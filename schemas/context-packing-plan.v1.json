{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://omp.local/agent-operator/schemas/context-packing-plan.v1.json","title":"ContextPackingPlan.v1","type":"object","additionalProperties":false,"required":["schemaVersion","planId","policyId","maxTokens","totalEstimatedTokens","blocked","decisions"],"properties":{"schemaVersion":{"const":"1.0"},"planId":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policyId":{"type":"string","minLength":1},"maxTokens":{"type":"integer","minimum":1},"totalEstimatedTokens":{"type":"integer","minimum":0},"blocked":{"type":"boolean"},"decisions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["itemId","status","estimatedTokens","reasonCode"],"properties":{"itemId":{"type":"string","minLength":1},"status":{"enum":["INCLUDED","EXCLUDED","BLOCKED"]},"representation":{"enum":["FULL","SYMBOL_EXCERPT","SUMMARY","ARTIFACT_REFERENCE","EVIDENCE_ONLY"]},"estimatedTokens":{"type":"integer","minimum":0},"reasonCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"}}}}}}
