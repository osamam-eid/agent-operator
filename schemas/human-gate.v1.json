{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/human-gate.v1.json",
  "title": "HumanGate.v1",
  "description": "HumanGate.v1 (plan §9): a specific, evidence-bound decision point. Approval binds exactly to operatorSessionId, gateId, graphHash, and every relevant artifact hash; any graph or bound-artifact change invalidates it deterministically.",
  "type": "object",
  "properties": {
    "gateId": {
      "type": "string",
      "description": "Gate identifier, e.g. plan-approval-03.",
      "minLength": 1,
      "maxLength": 256
    },
    "operatorSessionId": {
      "type": "string",
      "description": "Owning OperatorSession.operatorSessionId.",
      "minLength": 1,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "description": "Why this gate opened.",
      "minLength": 1,
      "maxLength": 2000
    },
    "decisionType": {
      "$ref": "#/$defs/GateDecisionType"
    },
    "requestedDecision": {
      "type": "string",
      "description": "What the human is being asked to decide, e.g. approve implementation.",
      "minLength": 1,
      "maxLength": 2000
    },
    "availableOptions": {
      "type": "array",
      "description": "Selectable options, e.g. APPROVE, REJECT, REQUEST_REPLAN.",
      "items": {
        "type": "string",
        "description": "Option token.",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "recommendedOption": {
      "type": "string",
      "description": "Operator-recommended option; must be a member of availableOptions.",
      "minLength": 1,
      "maxLength": 64
    },
    "evidenceRefs": {
      "type": "array",
      "description": "Evidence.evidenceId refs grounding this gate.",
      "items": {
        "type": "string",
        "description": "evidenceId reference.",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "consequences": {
      "type": "object",
      "description": "Keyed exactly by the members of availableOptions; each option carries an explicit consequence description.",
      "propertyNames": {
        "type": "string",
        "description": "Option token; must be a member of availableOptions.",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "description": "Consequence description.",
        "minLength": 1,
        "maxLength": 1000
      },
      "minProperties": 0
    },
    "resumeNode": {
      "$ref": "#/$defs/NodeIdRef"
    },
    "graphRevision": {
      "type": "integer",
      "description": "ExecutionGraph.graphRevision this gate is bound to.",
      "minimum": 1
    },
    "graphHash": {
      "type": "string",
      "description": "ExecutionGraph.graphHash this gate is bound to.",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRefs": {
      "type": "array",
      "description": "Bound ArtifactManifest.artifactId refs.",
      "items": {
        "type": "string",
        "description": "artifactId reference.",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifactHashes": {
      "type": "array",
      "description": "Content hashes, index-aligned with artifactRefs.",
      "items": {
        "type": "string",
        "description": "Content hash.",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "policyRefs": {
      "type": "array",
      "description": "Versioned policy citations for this gate.",
      "items": {
        "$ref": "#/$defs/PolicyRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "riskSummary": {
      "type": "object",
      "description": "Structured graph-bound risk information; it never changes gate authority.",
      "additionalProperties": false,
      "required": ["riskLevel", "disclosureClass", "mutationClasses", "providers", "tools", "scopedNodes", "actionsNotPerformed", "recoveryRequired", "expectedProviderCalls", "maximumDepth", "estimatedCost", "costConfidence", "previewReasons"],
      "properties": {
        "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "disclosureClass": { "enum": ["LOCAL_ONLY", "INTERNAL_REDACTABLE", "EXTERNAL_ALLOWED"] },
        "mutationClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["READ_ONLY", "LOCAL", "EXTERNAL", "DESTRUCTIVE"] } },
        "providers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "scopedNodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/NodeIdRef" } },
        "actionsNotPerformed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "recoveryRequired": { "type": "boolean" },
        "expectedProviderCalls": { "type": "integer", "minimum": 0 },
        "maximumDepth": { "type": "integer", "minimum": 0 },
        "estimatedCost": { "type": ["number", "null"], "minimum": 0 },
        "costConfidence": { "enum": ["UNAVAILABLE", "LOW", "MEDIUM", "HIGH"] },
        "previewReasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the gate was opened."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the gate expires, when short-lived."
    },
    "status": {
      "$ref": "#/$defs/GateStatus"
    }
  },
  "required": [
    "gateId",
    "operatorSessionId",
    "reason",
    "decisionType",
    "requestedDecision",
    "availableOptions",
    "recommendedOption",
    "evidenceRefs",
    "consequences",
    "resumeNode",
    "graphRevision",
    "graphHash",
    "artifactRefs",
    "artifactHashes",
    "policyRefs",
    "createdAt",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "GateDecisionType": {
      "type": "string",
      "description": "HumanGate decision category (plan §9, §18).",
      "enum": [
        "PLAN_APPROVAL",
        "EXECUTION_APPROVAL",
        "RESULT_APPROVAL",
        "PUBLICATION_APPROVAL",
        "APPROVE_PROGRESSION",
        "CUSTOM_DECISION"
      ]
    },
    "GateStatus": {
      "type": "string",
      "description": "Lifecycle status of a HumanGate. SUPERSEDED covers plan §9: any graph or bound-artifact change invalidates a prior approval deterministically and opens a new gate.",
      "enum": [
        "OPEN",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "SUPERSEDED"
      ]
    },
    "NodeIdRef": {
      "type": "string",
      "description": "Graph/template nodeId reference.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "PolicyRef": {
      "type": "string",
      "description": "Versioned policy citation, e.g. masar@3:review.maxRounds or secure-code@2:independentVerification (plan §5, §6).",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+:[a-zA-Z0-9_.]+$"
    }
  }
}
