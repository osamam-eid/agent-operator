{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/simulation-result.v1.json",
  "title": "SimulationResultEnvelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "generatedAt",
    "classification",
    "disclosureDecision",
    "routeDecision",
    "executionGraph",
    "executionEstimate",
    "capabilities",
    "decisionTrace",
    "preflight"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "request": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestClassification", "riskClassification", "confidence", "decomposable", "semanticCapabilities", "rationale"],
      "properties": {
        "requestClassification": { "enum": ["DIRECT", "RESEARCH", "PLAN", "IMPLEMENT", "REVIEW", "UI", "QA", "SECURITY", "OPERATIONS"] },
        "riskClassification": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "abstentionReason": { "type": "string", "minLength": 1 },
        "decomposable": { "type": "boolean" },
        "semanticCapabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requestedExecutionShape": { "enum": ["DIRECT", "SINGLE", "PARALLEL", "PIPELINE", "COUNCIL"] },
        "requestedBudgetProfile": { "enum": ["CHEAP", "BALANCED", "QUALITY", "CRITICAL"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "disclosureDecision": { "$ref": "runtime-disclosure-decision.v1.json" },
    "routeDecision": { "$ref": "route-decision.v1.json" },
    "executionGraph": { "$ref": "execution-graph.v1.json" },
    "executionEstimate": { "$ref": "execution-estimate.v1.json" },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "role", "capabilityId", "provider", "tools", "mutationClass"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "capabilityId": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "tools": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "mutationClass": { "enum": ["READ_ONLY", "LOCAL", "EXTERNAL", "DESTRUCTIVE"] }
        }
      }
    },
    "decisionTrace": { "$ref": "decision-trace.v1.json" },
    "preflight": { "enum": ["PASSED", "NOT_CONFIGURED"] }
  }
}
