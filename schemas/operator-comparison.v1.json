{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/operator-comparison.v1.json",
  "title": "OperatorComparison.v1",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PROMOTE_RECOMMENDED",
        "REJECT",
        "HOLD",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "baselineTotal": {
      "type": "number"
    },
    "candidateTotal": {
      "type": "number"
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hardFailures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scoredCases": {
      "type": "integer"
    }
  },
  "required": [
    "runId",
    "verdict",
    "baselineTotal",
    "candidateTotal",
    "regressions",
    "hardFailures",
    "scoredCases"
  ],
  "additionalProperties": false
}