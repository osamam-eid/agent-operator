{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/failure-fingerprint.v1.json",
  "title": "FailureFingerprint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fingerprint", "reasonCode", "status", "adapterId", "modelProvider", "modelId", "capabilityId", "nodeId", "mutationClass"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reasonCode": { "enum": ["PROVIDER_AUTH_FAILURE", "MODEL_CAPABILITY_MISMATCH", "TOOL_PERMISSION_DENIED", "TEST_REGRESSION", "PLAN_CONFORMANCE_FAILURE", "CONTEXT_OVERFLOW", "MUTATION_RECONCILIATION_REQUIRED", "PROVIDER_TIMEOUT", "REPEATED_VERIFICATION_FAILURE", "NODE_EXECUTION_FAILURE"] },
    "status": { "enum": ["FAILED", "BLOCKED", "CANCELLED", "UNKNOWN"] },
    "adapterId": { "type": "string", "minLength": 1 },
    "modelProvider": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "nodeId": { "type": "string", "minLength": 1 },
    "mutationClass": { "enum": ["READ_ONLY", "LOCAL", "EXTERNAL", "DESTRUCTIVE"] }
  }
}
