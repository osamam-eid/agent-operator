{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/operator-eval-corpus.v1.json",
  "title": "OperatorEvalCorpus.v1",
  "type": "object",
  "properties": {
    "corpusId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "disclosure": {
            "enum": [
              "LOCAL_ONLY",
              "REDACTED_INTERNAL",
              "EXTERNAL_REPLAY_APPROVED"
            ]
          },
          "partition": {
            "enum": [
              "TRAIN",
              "HELD_OUT"
            ]
          }
        },
        "required": [
          "caseId",
          "disclosure",
          "partition"
        ],
        "additionalProperties": false
      }
    },
    "trainManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "heldOutManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "corpusId",
    "revision",
    "createdAt",
    "cases",
    "trainManifestHash",
    "heldOutManifestHash"
  ],
  "additionalProperties": false
}