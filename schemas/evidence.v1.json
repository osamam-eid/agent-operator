{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/evidence.v1.json",
  "title": "Evidence.v1",
  "description": "Evidence.v1 (plan §11): a claim grounded in a concrete, independently checkable source.",
  "type": "object",
  "properties": {
    "evidenceId": {
      "type": "string",
      "description": "Evidence identifier.",
      "minLength": 1,
      "maxLength": 256
    },
    "type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "source": {
      "type": "string",
      "description": "Where the evidence originated (command, tool, or observation source); portable, no hardcoded usernames/paths.",
      "minLength": 1,
      "maxLength": 512
    },
    "artifact": {
      "type": "string",
      "description": "Referenced ArtifactManifest.artifactId, when the evidence is backed by a stored artifact.",
      "minLength": 1,
      "maxLength": 256
    },
    "claim": {
      "type": "string",
      "description": "The specific claim this evidence supports or refutes.",
      "minLength": 1,
      "maxLength": 2000
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the evidence was captured."
    },
    "producer": {
      "type": "string",
      "description": "Role or nodeId that produced this evidence.",
      "minLength": 1,
      "maxLength": 128
    },
    "verificationStatus": {
      "$ref": "#/$defs/EvidenceVerificationStatus"
    },
    "verifiedBy": {
      "type": "string",
      "description": "nodeId/role of the independent verifier.",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "evidenceId",
    "type",
    "source",
    "claim",
    "timestamp",
    "producer",
    "verificationStatus"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verificationStatus": {
            "const": "UNVERIFIED"
          }
        },
        "required": [
          "verificationStatus"
        ]
      },
      "then": {
        "not": {
          "required": [
            "verifiedBy"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "verificationStatus": {
            "enum": [
              "VERIFIED",
              "CONTRADICTED",
              "INCONCLUSIVE"
            ]
          }
        },
        "required": [
          "verificationStatus"
        ]
      },
      "then": {
        "required": [
          "verifiedBy"
        ]
      }
    }
  ],
  "$defs": {
    "EvidenceType": {
      "type": "string",
      "description": "Kind of evidence backing a claim.",
      "enum": [
        "TEST_RESULT",
        "COMMAND_OUTPUT",
        "FILE_DIFF",
        "SCREENSHOT",
        "LOG_EXCERPT",
        "EXTERNAL_SOURCE",
        "HUMAN_STATEMENT",
        "OTHER"
      ]
    },
    "EvidenceVerificationStatus": {
      "type": "string",
      "description": "Whether a claim's evidence has been independently verified.",
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "CONTRADICTED",
        "INCONCLUSIVE"
      ]
    }
  }
}
