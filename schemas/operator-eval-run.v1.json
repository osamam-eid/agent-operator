{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/operator-eval-run.v1.json",
  "title": "OperatorEvalRun.v1",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "corpusId": {
      "type": "string"
    },
    "corpusRevision": {
      "type": "integer"
    },
    "baselineDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "featureSetHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxCases": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplaysPerCase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxProviderTier": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "maxTokensPerCase": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxCases",
        "maxReplaysPerCase",
        "maxProviderTier",
        "maxTokensPerCase",
        "maxTotalCostUsd",
        "maxWallClockMs",
        "maxConcurrency"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string"
    },
    "perCase": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "replays": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "DONE",
              "SKIPPED_BUDGET",
              "ABORTED_SECRET_DETECTED"
            ]
          }
        },
        "required": [
          "caseId",
          "replays",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "budgetExhausted": {
      "type": "boolean"
    }
  },
  "required": [
    "runId",
    "corpusId",
    "corpusRevision",
    "baselineDigest",
    "featureSetHash",
    "budget",
    "startedAt",
    "perCase",
    "budgetExhausted"
  ],
  "additionalProperties": false
}