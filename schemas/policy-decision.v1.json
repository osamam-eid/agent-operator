{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/policy-decision.v1.json",
  "title": "PolicyDecision.v1",
  "description": "PolicyDecision.v1 (plan §8): the immutable, auditable record of one deterministic policy engine decision. A reviewer reporting FUNDAMENTAL_BLOCKER and policy deciding BLOCK are separate, immutable facts.",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string",
      "description": "Decision identifier.",
      "minLength": 1,
      "maxLength": 256
    },
    "subjectType": {
      "$ref": "#/$defs/PolicySubjectType"
    },
    "subjectId": {
      "type": "string",
      "description": "Identifier of the governed subject.",
      "minLength": 1,
      "maxLength": 256
    },
    "decision": {
      "$ref": "#/$defs/FindingEffectiveDisposition"
    },
    "reasonCodes": {
      "type": "array",
      "description": "Typed reason codes justifying this decision.",
      "items": {
        "$ref": "#/$defs/ReasonCodeToken"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "policyRefs": {
      "type": "array",
      "description": "Versioned policy citations that produced this decision.",
      "items": {
        "$ref": "#/$defs/PolicyRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "description": "Structured evaluation inputs (e.g. policy pack id/version, round number) as string key/value pairs.",
      "propertyNames": {
        "type": "string",
        "description": "Input field name.",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "description": "Input value.",
        "minLength": 0,
        "maxLength": 2000
      },
      "minProperties": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the decision was made."
    },
    "decisionSource": {
      "$ref": "#/$defs/PolicyDecisionSource"
    },
    "overrideGateId": {
      "type": "string",
      "description": "HumanGate.gateId whose human override produced this decision. Required and only present when decisionSource is HUMAN_OVERRIDE.",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "decisionId",
    "subjectType",
    "subjectId",
    "decision",
    "reasonCodes",
    "policyRefs",
    "inputs",
    "timestamp",
    "decisionSource"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decisionSource": {
            "const": "HUMAN_OVERRIDE"
          }
        },
        "required": [
          "decisionSource"
        ]
      },
      "then": {
        "required": [
          "overrideGateId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decisionSource": {
            "const": "POLICY"
          }
        },
        "required": [
          "decisionSource"
        ]
      },
      "then": {
        "not": {
          "required": [
            "overrideGateId"
          ]
        }
      }
    }
  ],
  "$defs": {
    "FindingEffectiveDisposition": {
      "type": "string",
      "description": "Deterministic policy-engine-owned disposition (plan §8); also reused as the PolicyDecision.decision vocabulary and AgentResult.recommendedDisposition. A human may override only through a named gate.",
      "enum": [
        "BLOCK",
        "CORRECT",
        "HUMAN_DECISION",
        "CONTINUE",
        "DEFER",
        "RECORD"
      ]
    },
    "PolicyRef": {
      "type": "string",
      "description": "Versioned policy citation, e.g. masar@3:review.maxRounds or secure-code@2:independentVerification (plan §5, §6).",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9-]*@[0-9]+:[a-zA-Z0-9_.]+$"
    },
    "PolicyDecisionSource": {
      "type": "string",
      "description": "Origin of a PolicyDecision (plan §8): POLICY is the deterministic engine; HUMAN_OVERRIDE is a named-gate human override, which requires overrideGateId.",
      "enum": [
        "POLICY",
        "HUMAN_OVERRIDE"
      ]
    },
    "PolicySubjectType": {
      "type": "string",
      "description": "Entity type a PolicyDecision governs (plan §8 example: subjectType: finding).",
      "enum": [
        "finding",
        "route",
        "node",
        "gate",
        "workflow"
      ]
    },
    "ReasonCodeToken": {
      "type": "string",
      "description": "SCREAMING_SNAKE_CASE typed reason token.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    }
  }
}
