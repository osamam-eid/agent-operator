{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omp.local/agent-operator/schemas/operator-eval-case.v1.json",
  "title": "OperatorEvalCase.v1",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "sourceSessionId": {
      "type": "string"
    },
    "originalRequest": {
      "type": "string"
    },
    "observed": {
      "type": "object",
      "properties": {
        "requestClassification": {
          "type": "string"
        },
        "riskClassification": {
          "type": "string"
        },
        "selectedWorkflow": {
          "type": "string"
        },
        "requiredGates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodeSummaries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              }
            },
            "required": [
              "nodeId",
              "summary"
            ],
            "additionalProperties": false
          }
        },
        "humanOverrideSignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requestClassification",
        "riskClassification",
        "selectedWorkflow",
        "requiredGates",
        "nodeSummaries",
        "humanOverrideSignals"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "requestClassification": {
          "type": "string"
        },
        "selectedWorkflow": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "disclosure": {
      "enum": [
        "LOCAL_ONLY",
        "REDACTED_INTERNAL",
        "EXTERNAL_REPLAY_APPROVED"
      ]
    },
    "approvedBy": {
      "type": "string"
    },
    "approvedAt": {
      "type": "string"
    }
  },
  "required": [
    "caseId",
    "sourceSessionId",
    "originalRequest",
    "observed",
    "disclosure"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disclosure": {
            "const": "EXTERNAL_REPLAY_APPROVED"
          }
        },
        "required": [
          "disclosure"
        ]
      },
      "then": {
        "required": [
          "approvedBy",
          "approvedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "disclosure": {
            "const": "LOCAL_ONLY"
          }
        },
        "required": [
          "disclosure"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "approvedBy"
              ]
            },
            {
              "required": [
                "approvedAt"
              ]
            }
          ]
        }
      }
    }
  ]
}